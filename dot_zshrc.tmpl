# =============================================================================
# dotfiles-core - shared .zshrc
# =============================================================================
# This file is generated by chezmoi from dot_zshrc.tmpl. Do not edit the
# rendered ~/.zshrc directly - your changes will be overwritten on the next
# `chezmoi apply`. For your own machine-specific tweaks (aliases, exports,
# functions, work tooling), use ~/.zshrc.local instead - see the bottom of
# this file, and dot_zshrc_local.example for a starter template.
#
# Kiro CLI pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# =============================================================================
# External Tool Pre-Initialization
# =============================================================================
# =============================================================================
# Oh-My-Zsh Configuration
# =============================================================================
export ZSH="${HOME}/.oh-my-zsh"
export ZSH_CUSTOM="${HOME}/.oh-my-zsh-custom"
ZSH_THEME="agnoster"

# Oh-My-Zsh Settings
COMPLETION_WAITING_DOTS="true"
DISABLE_AUTO_UPDATE="true"
DISABLE_COMPFIX="true"
DISABLE_MAGIC_FUNCTIONS="true"
HIST_STAMPS="yyyy-mm-dd"

# Plugins (alphabetically sorted)
plugins=(
  aws
  brew
  colored-man-pages
  docker
  docker-compose
  emoji
  gh
  git
  git-lfs
  gpg-agent
  history
  iterm2
  kubectl
  ssh-agent
  transfer
  vscode
  zsh-autosuggestions
  zsh-syntax-highlighting  # Always last!
)

# Zsh Autosuggestions Configuration
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

# Initialize Oh-My-Zsh
source $ZSH/oh-my-zsh.sh

# Custom prompt + theme colors (see dot_oh-my-zsh-custom/ in this repo).
# oh-my-zsh auto-sources every *.zsh file under $ZSH_CUSTOM, so
# theme-colors.zsh needs no explicit source line here - only prompt.zsh
# does, because it replaces (rather than augments) the agnoster theme.
[[ -f ${ZSH_CUSTOM}/prompt.zsh ]] && source ${ZSH_CUSTOM}/prompt.zsh

# =============================================================================
# PATH Configuration
# =============================================================================
export PATH="$HOME/.bun/bin:$HOME/bin:$HOME/.local/bin:$HOME/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# =============================================================================
# Environment Variables (alphabetically sorted)
# =============================================================================
export ANSIBLE_HOST_KEY_CHECKING=False
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export EDITOR="nvim"
export ENABLE_LSP_TOOL=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_REQUIRE_TAP_TRUST=1

# Local private shell overrides. This file is NOT managed by chezmoi and
# will never be touched by `chezmoi apply` - it's the right place for
# machine-specific or work-specific secrets, aliases, exports, and
# functions. See dot_zshrc_local.example for a starter template; a
# run_once script seeds ~/.zshrc.local from that example the first time
# chezmoi runs on a machine that doesn't already have one.
[[ -f "${HOME}/.zshrc.local" ]] && source "${HOME}/.zshrc.local"

# =============================================================================
# Aliases (alphabetically sorted)
# =============================================================================
# bat itself is left unaliased so `bat` by name still gets full paging.
# `cat` is remapped to bat without a pager: bare `bat` invokes `less` for
# anything over one screen, which is wrong for a cat replacement. Piped
# output is already safe (bat auto-degrades to plain text when stdout is
# not a TTY), and aliases don't apply inside scripts anyway.
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
alias dcp="docker compose pull"
alias dcs="docker compose stop"
alias dcu="docker compose up -d"
alias GitRebaseSigned="git rebase --exec 'git commit --amend --no-edit -n -S' -i"
alias ports='lsof -i -P -n | grep LISTEN'
command -v gtimeout >/dev/null 2>&1 && alias timeout="gtimeout"
command -v htop >/dev/null 2>&1 && alias top='htop'
command -v nvim >/dev/null 2>&1 && alias vi="nvim"
command -v nvim >/dev/null 2>&1 && alias vim="nvim"

# =============================================================================
# Functions
# =============================================================================
checkport() {
  sudo lsof -i :$1 -P
}

# =============================================================================
# Completion Setup
# =============================================================================
# Add completion paths before initializing (only if present - Docker
# Desktop isn't guaranteed to be installed on every machine).
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

# Smarter completion initialization (only run once)
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
  compinit
else
  compinit -C
fi

# ngrok completions
if command -v ngrok &>/dev/null; then
  eval "$(ngrok completion)"
fi

# =============================================================================
# Tool Initialization (must be at end)
# =============================================================================
{{- if eq .profile "michael" }}
# SDKMAN - MUST BE AT THE END
# Profile-gated: SDKMAN is a Michael-specific JVM toolchain manager, not
# something every machine sharing this repo is expected to have.
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
{{- end }}

# mise (handles pnpm and other tools)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"

  # `mise activate` unconditionally prepends its shims dir to the very front
  # of PATH, ahead of Homebrew, which lets a stale/orphaned shim shadow a
  # Homebrew binary of the same name (e.g. claude, python3). Move it to the
  # end so Homebrew wins any name collision while shims stay on PATH for
  # tools mise manages exclusively.
  path=("${(@)path:#$HOME/.local/share/mise/shims}")
  path+=("$HOME/.local/share/mise/shims")
fi

# =============================================================================
# External Tool Post-Initialization
# =============================================================================

# Graphite CLI completions (no-op if `gt` isn't installed - this only
# registers a completion function, it doesn't invoke `gt`).
#compdef gt
###-begin-gt-completions-###
#
# yargs command completion script
#
# Installation: gt completion >> ~/.zshrc
#    or gt completion >> ~/.zprofile on OSX.
#
_gt_yargs_completions()
{
  local reply
  local si=$IFS
  IFS=$'
' reply=($(COMP_CWORD="$((CURRENT-1))" COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" gt --get-yargs-completions "${words[@]}"))
  IFS=$si
  _describe 'values' reply
}
compdef _gt_yargs_completions gt
###-end-gt-completions-###

[[ -d "$HOME/.maestro/bin" ]] && export PATH=$PATH:$HOME/.maestro/bin

# Kiro CLI post block. Keep at the bottom of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"
