#!/usr/bin/env bash
# gh: run GitHub's `gh` with a GitHub App token inside coding-agent sessions.
#
# Outside an agent session this hands straight over to the real gh, so `gh`
# behaves exactly as it always has. Inside one (Claude Code, Codex, Cursor's
# agent, Antigravity's agy, Gemini CLI), every gh call gets GH_TOKEN set to an
# installation token from the GitHub App of the account that owns the target
# repository. Agents then stop spending the 5,000 requests an hour that your
# own gh login shares with everything you do yourself.
#
# Setup, once per account: see "GitHub App tokens for coding agents" in
# SETUP.md. In short, create a GitHub App, install it on the account, keep its
# app_id, installation_id and private_key in a 1Password item, and add a line
# for the account to ~/.config/gh-app-token/apps:
#
#   <owner><TAB><1Password item reference, such as op://Vault/Item>
#
# The first line is the default account. Lines starting with # are comments.
#
# Hands over to the real gh untouched when any of these hold:
#   - this is not an agent session (no marker below and no opt-in)
#   - GH_TOKEN or GITHUB_TOKEN is already set: an explicit token wins
#   - GH_APP_TOKEN_DISABLE=1 (opt-out)
#   - there is no config file
#   - the command never talks to GitHub (no arguments, help, version,
#     completion, config, alias), so there is no reason to touch 1Password
#
# Agent session markers (a non-empty value counts):
#   CLAUDECODE         Claude Code, in every shell it starts
#   CODEX_THREAD_ID    Codex CLI, in every shell command it runs
#   CODEX_SANDBOX      Codex CLI, when the command runs in its sandbox
#   CURSOR_AGENT       Cursor's agent (cursor-agent and the editor's agent)
#   ANTIGRAVITY_AGENT  Antigravity's agy
#   GEMINI_CLI         Gemini CLI
# For a harness without a marker, set GH_APP_TOKEN_ENABLE=1.
#
# Which account: the owner of the target, taken from the first of these that
# names one: -R/--repo; a `gh api` endpoint (repos/OWNER/..., orgs/OWNER/...,
# users/OWNER) or an owner= field; a github.com URL argument; the repository
# in `gh repo <verb> OWNER/REPO`; GH_REPO; the current directory's git origin.
# Arguments come before GH_REPO because they name the target exactly, the way
# gh itself lets a URL override GH_REPO. An owner with no line in the config,
# or no owner at all, uses the default account's App (an installation token
# can read public repositories anywhere).
#
# Tokens are cached per account in ~/.cache/gh-app-token (folder 0700, files
# 0600) and reused while more than 10 minutes of their hour remain. A lock
# makes parallel gh calls wait for one mint instead of all asking 1Password.
# The private key goes from `op read` to gh-token through a pipe and never
# touches disk.
#
# Inside an agent session this fails closed: if no token can be minted, it
# prints one line naming the account and the fix, exits non-zero, and never
# falls back to your own gh login. It never prints a token or key, not even
# with GH_APP_TOKEN_DEBUG=1 (which explains each decision on stderr).
#
# Other settings:
#   GH_APP_TOKEN_REAL_GH  path of the real gh (default: the next gh on PATH)
#   GH_APP_TOKEN_NOW      the current time in epoch seconds (for tests)
#
# git over SSH is untouched: this only changes what the gh command sends.
#
# Works with macOS's stock /bin/bash 3.2.
set -u

prog="gh-app-token"
self="${BASH_SOURCE[0]}"

debug() {
  if [ -n "${GH_APP_TOKEN_DEBUG:-}" ]; then printf '%s: %s\n' "$prog" "$*" >&2; fi
  return 0
}

# The real gh: GH_APP_TOKEN_REAL_GH, else the first gh on PATH that is not
# this file (compared by inode, so a symlink to this file is skipped too).
find_real_gh() {
  local rest dir
  if [ -n "${GH_APP_TOKEN_REAL_GH:-}" ]; then
    if [ -x "$GH_APP_TOKEN_REAL_GH" ] && ! [ "$GH_APP_TOKEN_REAL_GH" -ef "$self" ]; then
      printf '%s\n' "$GH_APP_TOKEN_REAL_GH"
      return 0
    fi
    return 1
  fi
  rest="${PATH}:"
  while [ -n "$rest" ]; do
    dir="${rest%%:*}"
    rest="${rest#*:}"
    [ -n "$dir" ] || dir="."
    if [ -f "$dir/gh" ] && [ -x "$dir/gh" ] && ! [ "$dir/gh" -ef "$self" ]; then
      printf '%s\n' "$dir/gh"
      return 0
    fi
  done
  return 1
}

if ! real_gh="$(find_real_gh)"; then
  printf '%s: no real gh found on PATH (only this wrapper, %s). Fix: brew install gh\n' "$prog" "$self" >&2
  exit 127
fi

handover() { exec "$real_gh" "$@"; }

# ---- should this call use an App token at all? ------------------------------
if [ "${GH_APP_TOKEN_DISABLE:-}" = 1 ]; then
  debug "GH_APP_TOKEN_DISABLE=1: using your own gh login"
  handover "$@"
fi
if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
  debug "GH_TOKEN or GITHUB_TOKEN is already set: using it"
  handover "$@"
fi

marker=""
for v in CLAUDECODE CODEX_THREAD_ID CODEX_SANDBOX CURSOR_AGENT ANTIGRAVITY_AGENT GEMINI_CLI; do
  if [ -n "${!v:-}" ]; then
    marker="$v"
    break
  fi
done
if [ -z "$marker" ]; then
  if [ "${GH_APP_TOKEN_ENABLE:-}" = 1 ]; then
    marker="GH_APP_TOKEN_ENABLE"
  else
    handover "$@"
  fi
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/gh-app-token/apps"
if [ ! -f "$config" ]; then
  debug "agent session ($marker) but no $config: using your own gh login"
  handover "$@"
fi

case "${1:-}" in
  "" | -h | --help | help | --version | version | completion | config | alias)
    handover "$@"
    ;;
esac
debug "agent session ($marker)"

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# valid_owner NAME: a GitHub user or organization login.
valid_owner() {
  case "$1" in
    "" | -* | *[!A-Za-z0-9-]*) return 1 ;;
  esac
  return 0
}

# ---- the config file -----------------------------------------------------------
# ACCOUNTS holds one "owner<TAB>reference" line per account, owner lowercased.
ACCOUNTS=""
DEFAULT=""
TAB="$(printf '\t')"
while IFS= read -r line || [ -n "$line" ]; do
  line="${line#"${line%%[![:space:]]*}"}"
  case "$line" in "" | "#"*) continue ;; esac
  owner="${line%%[[:space:]]*}"
  ref="${line#"$owner"}"
  ref="${ref#"${ref%%[![:space:]]*}"}"
  ref="${ref%"${ref##*[![:space:]]}"}"
  if ! valid_owner "$owner" || [ -z "$ref" ]; then
    debug "ignoring a config line that is not '<owner><TAB><op:// reference>'"
    continue
  fi
  owner="$(lower "$owner")"
  [ -n "$DEFAULT" ] || DEFAULT="$owner"
  ACCOUNTS="${ACCOUNTS}${owner}${TAB}${ref}
"
done <"$config"

if [ -z "$DEFAULT" ]; then
  printf '%s: %s has no account lines. Fix: add "<owner><TAB>op://Vault/Item" to it (see SETUP.md)\n' "$prog" "$config" >&2
  exit 1
fi

# ref_for OWNER: print the configured reference for a lowercased owner.
ref_for() {
  local o r
  while IFS="$TAB" read -r o r; do
    if [ "$o" = "$1" ]; then
      printf '%s\n' "$r"
      return 0
    fi
  done <<EOF
$ACCOUNTS
EOF
  return 1
}

# ---- whose repository is this call about? ---------------------------------------
# owner_of_repo SPEC: owner from OWNER/REPO, HOST/OWNER/REPO or a URL.
owner_of_repo() {
  local s="$1" first
  case "$s" in
    http://* | https://*)
      s="${s#*://}"
      s="${s#*/}"
      ;;
    */*/*)
      first="${s%%/*}"
      case "$first" in *.*) s="${s#*/}" ;; esac
      ;;
    */*) ;;
    *) return 1 ;;
  esac
  s="${s%%/*}"
  valid_owner "$s" || return 1
  printf '%s\n' "$s"
}

# owner_of_url ARG: owner from a github.com web URL.
owner_of_url() {
  local s
  case "$1" in
    https://github.com/* | http://github.com/* | https://www.github.com/* | http://www.github.com/*) ;;
    *) return 1 ;;
  esac
  s="${1#*://}"
  s="${s#*/}"
  case "$s" in orgs/* | users/*) s="${s#*/}" ;; esac
  s="${s%%[/?#]*}"
  valid_owner "$s" || return 1
  printf '%s\n' "$s"
}

# owner_of_endpoint PATH: owner from a REST endpoint such as repos/OWNER/REPO.
owner_of_endpoint() {
  local s="$1"
  s="${s#https://api.github.com}"
  s="${s#/}"
  case "$s" in
    repos/* | orgs/* | users/*) s="${s#*/}" ;;
    *) return 1 ;;
  esac
  s="${s%%[/?#]*}"
  valid_owner "$s" || return 1
  printf '%s\n' "$s"
}

# owner_of_remote URL: owner from a git remote (ssh, scp-like or https).
owner_of_remote() {
  local s="$1"
  case "$s" in
    *://*)
      s="${s#*://}"
      s="${s#*/}"
      ;;
    *:*) s="${s#*:}" ;;
    *) return 1 ;;
  esac
  s="${s#/}"
  s="${s%%/*}"
  valid_owner "$s" || return 1
  printf '%s\n' "$s"
}

target=""
source=""

# -R/--repo, in any of pflag's spellings. Stops at "--".
prev=""
for a in "$@"; do
  [ "$a" = "--" ] && break
  spec=""
  case "$prev" in -R | --repo) spec="$a" ;; esac
  case "$a" in
    --repo=*) spec="${a#--repo=}" ;;
    -R?*) spec="${a#-R}" ;;
  esac
  if [ -n "$spec" ] && o="$(owner_of_repo "$spec")"; then
    target="$o"
    source="-R/--repo"
    break
  fi
  prev="$a"
done

# gh api: the endpoint is the first argument that is not a flag or a flag's
# value. An owner=VALUE field (common in GraphQL queries) also names it.
if [ -z "$target" ] && [ "${1:-}" = api ]; then
  shift_next=""
  endpoint=""
  field_owner=""
  first=1
  for a in "$@"; do
    if [ "$first" = 1 ]; then
      first=0
      continue
    fi
    if [ -n "$shift_next" ]; then
      case "$shift_next" in
        field) case "$a" in owner=*) [ -z "$field_owner" ] && field_owner="${a#owner=}" ;; esac ;;
      esac
      shift_next=""
      continue
    fi
    case "$a" in
      -f | -F | --field | --raw-field) shift_next=field ;;
      -X | --method | -H | --header | --input | -q | --jq | -t | --template | --hostname | --cache | -p | --preview) shift_next=value ;;
      -f?* | -F?*) case "${a#-?}" in owner=*) [ -z "$field_owner" ] && field_owner="${a#-?owner=}" ;; esac ;;
      --field=owner=* | --raw-field=owner=*) [ -z "$field_owner" ] && field_owner="${a#*=owner=}" ;;
      -*) ;;
      *) [ -z "$endpoint" ] && endpoint="$a" ;;
    esac
  done
  if [ -n "$endpoint" ] && o="$(owner_of_endpoint "$endpoint")"; then
    target="$o"
    source="the gh api endpoint"
  elif [ -n "$field_owner" ] && valid_owner "$field_owner"; then
    target="$field_owner"
    source="the gh api owner= field"
  fi
fi

if [ -z "$target" ]; then
  for a in "$@"; do
    [ "$a" = "--" ] && break
    if o="$(owner_of_url "$a")"; then
      target="$o"
      source="a github.com URL argument"
      break
    fi
  done
fi

if [ -z "$target" ] && [ "${1:-}" = repo ] && [ $# -ge 3 ]; then
  case "$3" in
    -*) ;;
    *)
      if o="$(owner_of_repo "$3")"; then
        target="$o"
        source="gh repo $2 $3"
      fi
      ;;
  esac
fi

if [ -z "$target" ] && [ -n "${GH_REPO:-}" ] && o="$(owner_of_repo "$GH_REPO")"; then
  target="$o"
  source="GH_REPO"
fi

if [ -z "$target" ] && command -v git >/dev/null 2>&1; then
  if url="$(git remote get-url origin 2>/dev/null)" && o="$(owner_of_remote "$url")"; then
    target="$o"
    source="this directory's git origin"
  fi
fi

account=""
if [ -n "$target" ]; then
  target="$(lower "$target")"
  if ref="$(ref_for "$target")"; then
    account="$target"
    debug "target owner $target (from $source) has its own App"
  else
    debug "target owner $target (from $source) has no App configured; using the default account's App ($DEFAULT)"
  fi
else
  debug "no target owner found; using the default account's App ($DEFAULT)"
fi
if [ -z "$account" ]; then
  account="$DEFAULT"
  ref="$(ref_for "$DEFAULT")"
fi

case "$ref" in
  op://*) ;;
  *)
    printf '%s: the %s line in %s is not an op:// 1Password reference. Fix: write it as "%s<TAB>op://Vault/Item"\n' "$prog" "$account" "$config" "$account" >&2
    exit 1
    ;;
esac

# ---- the token ---------------------------------------------------------------------
fail() { # REASON FIX
  printf '%s: no GitHub App token for %s: %s. Fix: %s\n' "$prog" "$account" "$1" "$2" >&2
  exit 1
}

now() {
  if [ -n "${GH_APP_TOKEN_NOW:-}" ]; then printf '%s\n' "$GH_APP_TOKEN_NOW"; else date +%s; fi
}

# epoch_of ISO8601: seconds since the epoch for a UTC "YYYY-MM-DDTHH:MM:SSZ".
epoch_of() {
  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || date -u -d "$1" +%s 2>/dev/null
}

umask 077
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gh-app-token"
if ! mkdir -p "$cache_dir" 2>/dev/null || ! chmod 700 "$cache_dir" 2>/dev/null; then
  fail "cannot create $cache_dir" "check that folder is writable"
fi
cache="$cache_dir/$account.token"
MIN_LEFT=600

token=""
# fresh_cache: load $token from the cache if more than MIN_LEFT seconds remain.
fresh_cache() {
  local exp tok left
  token=""
  [ -f "$cache" ] || return 1
  { IFS= read -r exp && IFS= read -r tok; } <"$cache" 2>/dev/null || return 1
  case "$exp" in "" | *[!0-9]*) return 1 ;; esac
  [ -n "$tok" ] || return 1
  left=$((exp - $(now)))
  [ "$left" -gt "$MIN_LEFT" ] || return 1
  token="$tok"
  debug "using the cached token for $account ($((left / 60)) minutes left)"
  return 0
}

# Lock on file descriptor 9 with flock(2): the kernel wakes a waiter when the
# holder finishes, and a holder that dies releases the lock on its own.
# flock(1) where it exists (Linux), else perl, which macOS ships. Children
# get fd 9 closed so none of them can keep the lock alive.
if command -v flock >/dev/null 2>&1; then
  lock_tool=flock
elif command -v perl >/dev/null 2>&1; then
  lock_tool=perl
else
  lock_tool=""
fi
lock_try() {
  case "$lock_tool" in
    flock) flock -n 9 ;;
    perl) perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or exit 2; exit(flock($f, LOCK_EX | LOCK_NB) ? 0 : 1)' ;;
  esac
}
lock_wait() {
  case "$lock_tool" in
    flock) flock -w 60 9 ;;
    perl) perl -MFcntl=:flock -e 'alarm 60; open(my $f, ">&=", 9) or exit 2; exit(flock($f, LOCK_EX) ? 0 : 1)' ;;
  esac
}

find_minter() {
  local m
  if m="$(command -v gh-token 2>/dev/null)"; then
    printf '%s\n' "$m"
    return 0
  fi
  if command -v mise >/dev/null 2>&1 && m="$(cd "$HOME" && mise which gh-token 2>/dev/null 9>&-)" && [ -x "$m" ]; then
    printf '%s\n' "$m"
    return 0
  fi
  return 1
}

# last_error FILE: the last line of an error output, with anything shaped like
# a GitHub token or a PEM block removed.
last_error() {
  local line
  # shellcheck disable=SC2016 # sed's $ (last line), not a shell expansion
  line="$(sed -e '/-----BEGIN/,/-----END/d' "$1" 2>/dev/null | sed -n '/[^[:space:]]/h; ${x;p;}')"
  printf '%s' "$line" | sed -E 's/gh[opsur]_[A-Za-z0-9_]+/[redacted]/g; s/github_pat_[A-Za-z0-9_]+/[redacted]/g'
}

mint() {
  local errf app_id inst_id minter json exp_iso exp msg
  command -v op >/dev/null 2>&1 ||
    fail "the 1Password CLI (op) is not installed" "brew install --cask 1password-cli"
  minter="$(find_minter)" ||
    fail "gh-token is not installed" "run: mise install (it is in ~/.config/mise/config.toml)"
  errf="$cache_dir/.error.$$"
  : >"$errf"
  if ! app_id="$(op read "$ref/app_id" 2>"$errf" 9>&-)" || [ -z "$app_id" ] ||
    ! inst_id="$(op read "$ref/installation_id" 2>"$errf" 9>&-)" || [ -z "$inst_id" ]; then
    msg="$(last_error "$errf")"
    rm -f "$errf"
    fail "could not read app_id and installation_id from $ref${msg:+ ($msg)}" \
      "sign in to 1Password (op signin) and check that item has app_id, installation_id and private_key fields"
  fi
  debug "minting a token for $account"
  json="$("$minter" generate --app-id "$app_id" --installation-id "$inst_id" \
    --key <(op read "$ref/private_key" 2>/dev/null 9>&-) 2>"$errf" 9>&-)" || {
    msg="$(last_error "$errf")"
    rm -f "$errf"
    fail "gh-token could not mint one${msg:+ ($msg)}" \
      "check that the App is installed on $account and that app_id, installation_id and private_key in $ref belong to it"
  }
  rm -f "$errf"
  token="$(printf '%s\n' "$json" | sed -n 's/^[[:space:]]*"token":[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n 1p)"
  exp_iso="$(printf '%s\n' "$json" | sed -n 's/^[[:space:]]*"expires_at":[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n 1p)"
  case "$token" in
    "" | *[!A-Za-z0-9_]*)
      token=""
      fail "gh-token answered with something that is not a token" "run: mise install (to get a working gh-token)"
      ;;
  esac
  # Installation tokens last an hour. If the expiry cannot be read, assume
  # 50 minutes so a reused token never outlives the real one.
  exp="$(epoch_of "$exp_iso")" || exp=""
  case "$exp" in "" | *[!0-9]*) exp=$(($(now) + 3000)) ;; esac
  if ! { printf '%s\n%s\n' "$exp" "$token" >"$cache.$$" && mv -f "$cache.$$" "$cache"; }; then
    rm -f "$cache.$$"
    debug "could not write the token cache in $cache_dir; continuing without it"
  fi
}

if ! fresh_cache; then
  if [ -z "$lock_tool" ]; then
    debug "neither flock nor perl is installed; minting without a lock"
  elif exec 9>>"$cache_dir/$account.lock"; then
    if ! lock_try; then
      debug "waiting for another gh call that is minting a token for $account"
      lock_wait ||
        fail "another gh call has held the token lock for over a minute" "try again; if it keeps happening, delete $cache_dir/$account.lock"
    fi
  else
    debug "cannot open $cache_dir/$account.lock; minting without a lock"
  fi
  fresh_cache || mint
  exec 9>&-
fi

# Never hand gh an empty GH_TOKEN: it would fall back to your own login.
[ -n "$token" ] || fail "no token came back" "run with GH_APP_TOKEN_DEBUG=1 to see each step"
GH_TOKEN="$token" exec "$real_gh" "$@"
